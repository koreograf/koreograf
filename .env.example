# Kopieren nach .env. Leere Werte nutzen die eingebauten Vorgaben.
# Compose übergibt Logformat, Datenbank-URL und Proxy in den Container.
# Bind, Datenverzeichnis, Web und Beispiele setzt docker-compose.yml fest
# (0.0.0.0:8080, /var/lib/koreograf, /opt/koreograf/web, /opt/koreograf/examples).
# Eine gesetzte Shell-Variable ersetzt den Wert aus dieser Datei.
KOREOGRAF_BIND=0.0.0.0:8080
KOREOGRAF_DATA=./data
KOREOGRAF_WEB=./web
KOREOGRAF_EXAMPLES=./examples
KOREOGRAF_ADMIN_USER=admin
KOREOGRAF_ADMIN_PASSWORD=
KOREOGRAF_RUNNER=auto
KOREOGRAF_JOB_TIMEOUT_SECS=1800
# 64 Hex-Zeichen. Leer lassen, dann legt der erste Start data/secret.key an.
KOREOGRAF_SECRET_KEY=
# stdout-Format: leer oder text. json stellt tracing auf JSON, zum Beispiel für Promtail.
KOREOGRAF_LOG_FORMAT=
# Leer lassen für SQLite unter KOREOGRAF_DATA. postgres:// bricht den Start ab, bis PostgreSQL angebunden ist.
KOREOGRAF_DATABASE_URL=

# LDAP oder Active Directory. Ohne URL bleibt die Anmeldung lokal.
KOREOGRAF_LDAP_URL=
# ldap oder ad
KOREOGRAF_LDAP_MODE=ldap
KOREOGRAF_LDAP_BIND_DN=
KOREOGRAF_LDAP_BIND_PASSWORD=
KOREOGRAF_LDAP_USER_BASE=
KOREOGRAF_LDAP_USER_FILTER=
KOREOGRAF_LDAP_USERNAME_ATTR=
KOREOGRAF_LDAP_GROUP_ATTR=memberOf
KOREOGRAF_LDAP_GROUP_BASE=
KOREOGRAF_LDAP_STARTTLS=false
KOREOGRAF_LDAP_TLS_INSECURE=false

# HTTP-Proxy, bis ein Admin unter Einstellungen speichert. Danach gilt die Oberfläche.
# Eine gespeicherte leere Adresse schaltet den Proxy aus. SSH-Git nutzt ihn nicht.
# Compose reicht einen Proxy-Namen nur durch, wenn er gesetzt ist.
# Eine leere Zeile nicht eintragen: leeres https_proxy schaltet HTTPS_PROXY aus.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1
