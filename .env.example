# Copy to .env. Empty values use the built-in defaults.
# Compose passes the log format, the database URL, and the proxy into the container.
# Bind, the data directory, web, and examples are fixed in docker-compose.yml
# (0.0.0.0:8080, /var/lib/koreograf, /opt/koreograf/web, /opt/koreograf/examples).
# A variable already set in the shell replaces the value from this file.
KOREOGRAF_BIND=0.0.0.0:8080
KOREOGRAF_DATA=./data
KOREOGRAF_WEB=./web
KOREOGRAF_EXAMPLES=./examples
KOREOGRAF_ADMIN_USER=admin
KOREOGRAF_ADMIN_PASSWORD=
KOREOGRAF_RUNNER=auto
# Absolute path the container daemon uses for KOREOGRAF_DATA.
# Empty detects the mount. Set this only when that lookup is wrong.
# KOREOGRAF_DATA_HOST=
# admins or all. Default admins: an operator and an anonymous webhook do not start a local job.
# all only on a trusted network, when webhooks must run locally.
KOREOGRAF_LOCAL_RUNNER_FOR=admins
# Comma-separated absolute directories. The examples directory is always allowed.
# A path or file:// project outside these roots does not start, including for administrators.
# KOREOGRAF_PROJECT_ROOTS=
KOREOGRAF_JOB_TIMEOUT_SECS=1800
# Lines kept for each of stdout and stderr. 100 to 100000.
# The job keeps the first three quarters and the last quarter.
KOREOGRAF_JOB_OUTPUT_LINES=8000
# 64 hex characters. Leave this empty and the first start creates data/secret.key.
KOREOGRAF_SECRET_KEY=
# stdout format: empty or text. json switches tracing to JSON, for example for Promtail.
KOREOGRAF_LOG_FORMAT=
# Send Strict-Transport-Security. Leave false on plain HTTP.
KOREOGRAF_HSTS=false
# true, false, or auto. auto sets Secure only when KOREOGRAF_TRUSTED_PROXY is true
# and the proxy sends X-Forwarded-Proto: https. Set true when TLS ends in front.
KOREOGRAF_COOKIE_SECURE=auto
# Read X-Forwarded-Proto for the session cookie. Leave false when clients reach the process directly.
KOREOGRAF_TRUSTED_PROXY=false
# Leave empty for SQLite under KOREOGRAF_DATA. postgres:// stops startup until PostgreSQL is connected.
KOREOGRAF_DATABASE_URL=

# LDAP or Active Directory. Without a URL, sign-in stays local.
KOREOGRAF_LDAP_URL=
# ldap or ad
KOREOGRAF_LDAP_MODE=ldap
KOREOGRAF_LDAP_BIND_DN=
KOREOGRAF_LDAP_BIND_PASSWORD=
KOREOGRAF_LDAP_USER_BASE=
KOREOGRAF_LDAP_USER_FILTER=
KOREOGRAF_LDAP_USERNAME_ATTR=
KOREOGRAF_LDAP_GROUP_ATTR=memberOf
KOREOGRAF_LDAP_GROUP_BASE=
KOREOGRAF_LDAP_STARTTLS=false
KOREOGRAF_LDAP_TLS_INSECURE=false
# Absolute PEM path in this process. Empty uses the system CAs.
# When this is set, certificate checks stay on and TLS insecure is ignored.
KOREOGRAF_LDAP_CA_FILE=

# HTTP proxy until an admin saves Settings. After that, the UI value applies.
# A saved empty address turns the proxy off. SSH Git does not use it.
# Compose forwards a proxy name only when it is set.
# Do not add an empty assignment: an empty https_proxy turns HTTPS_PROXY off.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1
