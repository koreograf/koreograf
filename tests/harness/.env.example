# Placeholders for the lab stack. up.sh writes the real values to
# tests/harness/.secrets/ and does not read this file.
# Those values belong to this lab. They are not production credentials.
# NETBOX_REDIS_PASSWORD is the name NetBox uses: the stack passes it to NetBox
# as REDIS_PASSWORD and to the Valkey cache as its requirepass value.
# Remove existing harness volumes once with down.sh -v after the switch to Valkey.

KOREOGRAF_ADMIN_PASSWORD=replace-me
LDAP_ADMIN_PASSWORD=replace-me
LDAP_USER_PASSWORD=replace-me
NETBOX_DB_PASSWORD=replace-me
NETBOX_REDIS_PASSWORD=replace-me
NETBOX_SECRET_KEY=replace-me
NETBOX_SUPERUSER_PASSWORD=replace-me
NETBOX_API_TOKEN_PEPPER=replace-me
NETBOX_HARNESS_TOKEN=replace-me
HARNESS_SSH_PUBLIC_KEY=ssh-ed25519 REPLACE_ME koreograf-harness
