[Unit]
Description=Koreograf
Documentation=https://github.com/koreograf/koreograf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=koreograf
Group=koreograf
EnvironmentFile=/etc/koreograf/koreograf.env
Environment=KOREOGRAF_WEB=/opt/koreograf/web
Environment=KOREOGRAF_EXAMPLES=/opt/koreograf/examples
WorkingDirectory=/var/lib/koreograf
ExecStart=/usr/bin/koreograf
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
StateDirectory=koreograf
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
