#!/bin/sh
# Playwright fixture. It stands in for OpenTofu on CI, where the real binary or
# its providers are not available, and emits the same machine-readable UI
# lines that `tofu plan -json` and `tofu apply -json` write.
set -eu

case "${1:-}" in
  version)
    printf '%s\n' "OpenTofu v1.8.0"
    ;;
  init)
    printf '%s\n' "Initializing the backend..."
    printf '%s\n' "Initializing provider plugins..."
    ;;
  plan)
    cat <<'EOF'
{"@level":"info","@message":"OpenTofu v1.8.0","type":"version","terraform":"1.8.0","ui":"1.0"}
{"@level":"info","@message":"terraform_data.web: Plan to create","type":"planned_change","change":{"resource":{"addr":"terraform_data.web","resource_type":"terraform_data","resource_name":"web"},"action":"create"}}
{"@level":"info","@message":"terraform_data.db: Plan to update","type":"planned_change","change":{"resource":{"addr":"terraform_data.db","resource_type":"terraform_data","resource_name":"db"},"action":"update"}}
{"@level":"info","@message":"terraform_data.old: Plan to delete","type":"planned_change","change":{"resource":{"addr":"terraform_data.old","resource_type":"terraform_data","resource_name":"old"},"action":"delete"}}
{"@level":"info","@message":"Plan: 1 to add, 1 to change, 1 to destroy.","type":"change_summary","changes":{"add":1,"change":1,"import":0,"remove":1,"operation":"plan"}}
{"@level":"warn","@message":"Warning: Deprecated attribute","type":"diagnostic","diagnostic":{"severity":"warning","summary":"Deprecated attribute","detail":"Use id instead of name."}}
{"@level":"info","@message":"Outputs:\n\nmessage = \"koreograf\"\nsecret = <sensitive>\n","type":"outputs","outputs":{"message":{"sensitive":false,"type":"string","value":"koreograf"},"secret":{"sensitive":true,"type":"string","value":"hunter2"}}}
EOF
    ;;
  apply)
    cat <<'EOF'
{"@level":"info","@message":"OpenTofu v1.8.0","type":"version","terraform":"1.8.0","ui":"1.0"}
{"@level":"info","@message":"terraform_data.web: Creating...","type":"apply_start","hook":{"resource":{"addr":"terraform_data.web"},"action":"create"}}
{"@level":"info","@message":"terraform_data.web: Creation complete after 1s","type":"apply_complete","hook":{"resource":{"addr":"terraform_data.web"},"action":"create"},"elapsed_seconds":1}
{"@level":"info","@message":"Apply complete! Resources: 1 added, 0 changed, 0 destroyed.","type":"change_summary","changes":{"add":1,"change":0,"import":0,"remove":0,"operation":"apply"}}
{"@level":"info","@message":"Outputs:\n\nmessage = \"koreograf\"\n","type":"outputs","outputs":{"message":{"sensitive":false,"type":"string","value":"koreograf"}}}
EOF
    ;;
  *)
    printf '%s\n' "unsupported tofu command: $*" >&2
    exit 1
    ;;
esac
